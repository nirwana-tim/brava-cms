# ------------------------------------------------------------------
# Brava CMS — Production environment template (cPanel shared hosting)
# ------------------------------------------------------------------
# 1. Salin file ini menjadi `.env` di server:
#       cp .env.production.example .env
# 2. Isi nilai di bawah (jangan pernah commit `.env` asli).
# 3. Jalankan `php artisan key:generate` setelah .env terpasang.
# ------------------------------------------------------------------

APP_NAME="Brava CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Domain backend (dipakai untuk absolute URL gambar & metadata)
APP_URL=https://cms.brava.id
# Domain website publik — dipakai untuk canonical URL & sitemap (bukan untuk CORS)
FRONTEND_URL=https://brava.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Akun yang dibuat oleh `php artisan db:seed` (Super Admin + Admin)
SUPERADMIN_EMAIL=superadmin@brava.id
SUPERADMIN_PASSWORD=
ADMIN_EMAIL=admin@brava.id
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database MySQL (buat DB + user di cPanel -> MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session & Cookies ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true setelah SSL aktif di cms.brava.id
SESSION_SECURE_COOKIE=true

# --- CORS ---
# Origin browser yang boleh memanggil API (frontend publik + preview Vercel).
# Data reads berjalan server-side di Next.js, jadi CORS hampir tidak relevan;
# daftar origin ini opsional untuk request browser di masa depan.
CORS_ALLOWED_ORIGINS=https://brava.id,https://brava-compro-git-dev-nirwana-tims-projects.vercel.app
# Gunakan pola jika preview Vercel sering berganti (opsional):
# CORS_ALLOWED_ORIGINS_PATTERNS=/^https:\/\/.*\.vercel\.app$/
CORS_SUPPORTS_CREDENTIALS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tidak ada queue job yang aktif; biarkan database.
QUEUE_CONNECTION=database

# --- Cache ---
# Store 'api' memakai tabel api_cache (sudah ada migration-nya).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (opsional — belum ada email aktif di app ini) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@brava.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Google Analytics 4 untuk dashboard admin (opsional) ---
# Path service-account JSON relatif ke storage/ atau absolut, atau wrap isi file.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY=
GA4_CACHE_FRESH=30
GA4_CACHE_STALE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
